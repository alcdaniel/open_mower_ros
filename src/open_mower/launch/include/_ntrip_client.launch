<?xml version="1.1"?>
<launch>
    <!-- ****************************************************************** -->
    <!-- NTRIP Watchdog — manages ntrip_client lifecycle gracefully.        -->
    <!--   - No credentials yet  → stays alive, logs warning, never crashes -->
    <!--   - Credential/network error → retries 3 times, then pauses 10 min -->
    <!--   - Normal disconnect   → reconnects immediately                    -->
    <!--   OM_USE_NTRIP and mower_config.sh are never modified.              -->
    <!-- ****************************************************************** -->
    <node name="ntrip_watchdog" pkg="open_mower" type="ntrip_watchdog.py"
          output="screen" respawn="true" respawn_delay="30">
        <param name="host"       value="$(optenv OM_NTRIP_HOSTNAME 192.148.213.42)"/>
        <param name="port"       value="$(optenv OM_NTRIP_PORT 2102)"/>
        <param name="mountpoint" value="$(optenv OM_NTRIP_ENDPOINT XIXO3M)"/>
        <param name="username"   value="$(optenv OM_NTRIP_USER)"/>
        <param name="password"   value="$(optenv OM_NTRIP_PASSWORD)"/>
    </node>
</launch>
