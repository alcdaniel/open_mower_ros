<?xml version="1.0"?>
<package format="2">
  <name>mower_mega_bridge</name>
  <version>1.0.0</version>
  <description>
    Serial bridge between Raspberry Pi (ROS) and Arduino Mega.
    Replaces mower_comms_v1/v2 and the xesc ESC stack for custom hardware.
  </description>
  <maintainer email="daniel@example.com">Daniel</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>mower_msgs</build_depend>
  <build_depend>serial</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mower_msgs</exec_depend>
  <exec_depend>serial</exec_depend>
</package>
