# OpenMower Environment Configuration
# Copy to ~/.env on Raspberry Pi and edit with your values
# Keep ~/.env private: chmod 600 ~/.env

# ─────────────────────────────────────────────────────
# WiFi Auto-Connect (for internet/NTRIP corrections)
# ─────────────────────────────────────────────────────
MOWER_WIFI_SSID="CHANGE_ME_WIFI_SSID"
MOWER_WIFI_PASSWORD="CHANGE_ME_WIFI_PASSWORD"
MOWER_WIFI_CONNECTION_NAME="openmower-wifi"

# ─────────────────────────────────────────────────────
# Optional NTRIP GPS Corrections (future rover feature)
# Free registration at: https://ergnss.ign.es/gnuserportal/
# ─────────────────────────────────────────────────────
NTRIP_CASTER_HOST="192.148.213.42" # Spain's public server for NTRIP casting
NTRIP_CASTER_PORT="2102"
NTRIP_MOUNTPOINT=""
NTRIP_USERNAME=""
NTRIP_PASSWORD=""

# ─────────────────────────────────────────────────────
# iOS App Bridge Configuration
# ─────────────────────────────────────────────────────
OM_IOS_BRIDGE_ENABLE="True"
OM_IOS_BRIDGE_HOST="0.0.0.0"
OM_IOS_BRIDGE_PORT="8080"
OM_IOS_BRIDGE_NAME="lawnmower"
OM_IOS_BRIDGE_TOKEN=""
OM_IOS_UDP_BEACON_ENABLE="True"
